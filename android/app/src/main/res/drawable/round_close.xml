<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#3A4029" />
            <stroke android:width="1dp" android:color="@color/amber_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#1F2417" />
            <stroke android:width="1dp" android:color="#4C5434" />
        </shape>
    </item>
</selector>
