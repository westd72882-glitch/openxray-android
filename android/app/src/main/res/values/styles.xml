<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenXRay.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:keepScreenOn">true</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorControlNormal">@color/text_muted</item>
        <item name="colorControlActivated">@color/amber_primary</item>
        <item name="colorAccent">@color/amber_primary</item>
        <item name="alertDialogTheme">@style/DarkAlert</item>
    </style>

    <style name="DarkAlert" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:colorBackground">#161A11</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="colorAccent">@color/amber_primary</item>
    </style>

    <style name="Sect">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/amber_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.16</item>
    </style>

    <style name="Lbl">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Chk" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">13sp</item>
        <item name="buttonTint">@color/amber_primary</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/pill_button</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Seek" parent="Widget.AppCompat.SeekBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:progressTint">@color/amber_primary</item>
        <item name="android:thumbTint">@color/amber_primary</item>
    </style>
</resources>
