<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="640dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="НАСТРОЙКИ"
                android:textColor="@color/amber_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <ImageView
                android:id="@+id/btn_settings_close"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="end"
                android:background="@drawable/round_close"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_main"
                android:contentDescription="Закрыть" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- Графика -->
                <TextView style="@style/Sect" android:text="ГРАФИКА" />

                <TextView style="@style/Lbl" android:text="Пресет графики" />
                <Spinner
                    android:id="@+id/spinner_graphics_preset"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:popupBackground="#161A11" />

                <TextView style="@style/Lbl" android:text="Разрешение экрана" />
                <Spinner
                    android:id="@+id/spinner_resolution"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:popupBackground="#161A11" />

                <TextView style="@style/Lbl" android:text="Графический API" />
                <Spinner
                    android:id="@+id/spinner_render_backend"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:popupBackground="#161A11" />
                <TextView
                    android:id="@+id/text_render_backend_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <CheckBox
                    android:id="@+id/check_noshadows"
                    style="@style/Chk"
                    android:layout_marginTop="6dp"
                    android:text="Без теней (-nodlights)" />
                <CheckBox
                    android:id="@+id/check_dlights"
                    style="@style/Chk"
                    android:text="Динамическое освещение (выкл. = статическое)" />
                <CheckBox
                    android:id="@+id/check_nosun"
                    style="@style/Chk"
                    android:text="Без солнца (r2_sun off)" />
                <CheckBox
                    android:id="@+id/check_fastdxt"
                    style="@style/Chk"
                    android:text="Быстрая распаковка DXT (bcdec)" />

                <!-- Игра -->
                <TextView style="@style/Sect" android:text="ИГРА" />
                <CheckBox
                    android:id="@+id/check_nointro"
                    style="@style/Chk"
                    android:text="Пропускать заставку (-nointro)" />
                <CheckBox
                    android:id="@+id/check_nosound"
                    style="@style/Chk"
                    android:text="Без звука (-nosound)" />

                <!-- Управление -->
                <TextView style="@style/Sect" android:text="СЕНСОРНОЕ УПРАВЛЕНИЕ" />
                <TextView
                    android:id="@+id/label_look_sens"
                    style="@style/Lbl"
                    android:text="Чувствительность камеры: 1.0x" />
                <SeekBar
                    android:id="@+id/seek_look_sens"
                    style="@style/Seek"
                    android:max="30"
                    android:progress="10" />

                <TextView
                    android:id="@+id/label_touch_opacity"
                    style="@style/Lbl"
                    android:text="Прозрачность кнопок: 60%" />
                <SeekBar
                    android:id="@+id/seek_touch_opacity"
                    style="@style/Seek"
                    android:max="100"
                    android:progress="60" />

                <TextView
                    android:id="@+id/label_touch_scale"
                    style="@style/Lbl"
                    android:text="Размер кнопок в игре: 100%" />
                <SeekBar
                    android:id="@+id/seek_touch_scale"
                    style="@style/Seek"
                    android:max="150"
                    android:progress="100" />

                <Button
                    android:id="@+id/btn_edit_touch_layout"
                    style="@style/Pill"
                    android:layout_marginTop="10dp"
                    android:drawableStart="@drawable/ic_edit"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/text_main"
                    android:text="РАСПОЛОЖЕНИЕ КНОПОК В ИГРЕ" />

                <!-- Лаунчер -->
                <TextView style="@style/Sect" android:visibility="gone" android:text="МЕНЮ ЛАУНЧЕРА" />
                <TextView
                    android:id="@+id/label_menu_scale"
                    android:visibility="gone"
                    style="@style/Lbl"
                    android:text="Размер круглых кнопок: 100%" />
                <SeekBar
                    android:id="@+id/seek_menu_scale"
                    android:visibility="gone"
                    style="@style/Seek"
                    android:max="140"
                    android:progress="100" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_edit_menu_layout"
                        style="@style/Pill"
                        android:text="ПЕРЕМЕСТИТЬ КНОПКИ" />

                    <Button
                        android:id="@+id/btn_reset_menu_layout"
                        style="@style/Pill"
                        android:layout_marginStart="8dp"
                        android:text="СБРОСИТЬ" />
                </LinearLayout>

                <!-- Дополнительно -->
                <TextView style="@style/Sect" android:text="ДОПОЛНИТЕЛЬНО" />
                <TextView style="@style/Lbl" android:text="Свои аргументы запуска" />
                <EditText
                    android:id="@+id/edit_custom_args"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="-xclsx"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_view_logs"
                        style="@style/Pill"
                        android:text="ЛОГИ" />

                    <Button
                        android:id="@+id/btn_report_bug"
                        style="@style/Pill"
                        android:layout_marginStart="8dp"
                        android:text="СООБЩИТЬ ОБ ОШИБКЕ" />

                    <Button
                        android:id="@+id/btn_support_dev"
                        style="@style/Pill"
                        android:layout_marginStart="8dp"
                        android:drawableStart="@drawable/ic_heart"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/amber_primary"
                        android:text="ПОДДЕРЖАТЬ"
                        android:textColor="@color/amber_primary" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
